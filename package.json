    "vue": "^3.4.0",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vitest/coverage-istanbul": "^1.6.1",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^14.12.3",
    "typescript": "^5.2.0",
    "vite": "^5.2.0",
    "vite-ssg": "^28.3.0",
    "vitest": "^1.6.0",
    "vue-tsc": "^2.0.0"
  }
}
