# .htaccess des fronts sd-edition (Vue Router en mode history, hébergement o2switch).
# Modèle : sd-edition-infra/templates/web/.htaccess — à copier dans <front>/public/ (Vite le
# recopie dans dist/ et le déploiement FTP l'envoie avec le build).
# Toute règle Apache d'un front se met ici, jamais dans cPanel : le déploiement écrase le
# .htaccess du serveur.

# Redirection permanente HTTP → HTTPS. X-Forwarded-Proto couvre le cas où le HTTPS est géré
# par un proxy en amont (sinon la règle bouclerait).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# ----- Spécifique sd-edition.fr (hors modèle commun) -----
# Page d'accueil = index.html : un index.php resté de WordPress serait sinon servi en priorité.
DirectoryIndex index.html

# Adresse canonique sans www (une seule version du site pour les moteurs de recherche).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
</IfModule>

# Anciennes URL WordPress : 410 Gone pour les fichiers techniques (robots de scan, flux RSS),
# afin qu'ils ne retombent pas sur le fallback SPA avec un code 200.
# Ajouter ici les redirections 301 des anciennes pages qui ont un équivalent, ex. :
#   RewriteRule ^ancienne-page/?$ /services [L,R=301]
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(wp-admin|wp-content|wp-includes|wp-json)(/.*)?$ - [G,L]
  RewriteRule ^(wp-[^/]*|xmlrpc|index)\.php$ - [G,L]
  RewriteRule ^(readme\.html|license\.txt|licence\.txt|wordfence-waf\.php|\.user\.ini|php\.ini|error_log)$ - [G,L]
  RewriteRule ^(.*/)?feed/?$ - [G,L]
  RewriteRule ^(comments|author|category|tag)(/.*)?$ - [G,L]
</IfModule>

# Pages pré-rendues au build (vite-ssg) : `/contact` est servi par `contact.html`. Une URL avec
# barre finale est redirigée vers l'URL sans barre. Toute autre URL inconnue répond 404 avec la
# page `404.html` : le fallback SPA du modèle commun (index.html avec un code 200) n'est donc
# plus atteint.
ErrorDocument 404 /404.html
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ https://%{HTTP_HOST}/$1 [R=301,L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ /$1.html [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . - [R=404,L]
</IfModule>
# ----- Fin du bloc spécifique -----

# Fallback SPA : toute URL qui ne correspond pas à un fichier ou dossier existant est servie par
# index.html, pour que le routeur côté client prenne le relais (rechargement d'une page, lien
# direct reçu par e-mail).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# index.html toujours revalidé : sans cela, le navigateur peut garder l'ancien index.html après
# un déploiement et charger l'ancien JavaScript. Les fichiers de /assets/ ont un nom qui change
# à chaque build : ils peuvent rester en cache.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
